# Sviluppo locale: copiare questo file in .env.local.
# Vercel: impostare la variabile nell'ambiente del progetto prima della build.
# Usare l'origine del backend senza /api e senza slash finale.
# La variabile è pubblica nel browser: non inserire segreti nelle variabili NEXT_PUBLIC_*.
# Backend Docker locale: porta 8081. Spring Boot avviato direttamente: porta 8080.
# Vercel richiede HTTPS e rifiuta localhost, anche nei deploy di anteprima.
NEXT_PUBLIC_API_URL=http://localhost:8081
